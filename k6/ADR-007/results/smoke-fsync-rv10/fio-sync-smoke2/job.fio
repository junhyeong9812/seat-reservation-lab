[global]
directory=/work
ioengine=psync
fallocate=none
time_based
runtime=60
log_avg_msec=1000
per_job_logs=1

[wal]
rw=write
bs=8k
fdatasync=1
overwrite=1
rate=16m
size=1G
filename=wal.dat
write_bw_log=wal
write_lat_log=wal

[data]
rw=write
bs=8k
rate=12m
fsync=4096
end_fsync=1
size=15G
filename=data.dat
write_bw_log=data
write_lat_log=data

